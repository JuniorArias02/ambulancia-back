# Aplicación
NODE_ENV=development
PUERTO=3000
CORS_ORIGENES=http://localhost:5173

# Base de datos (docker-compose)
DB_NOMBRE=ambulancias_galenos
DB_USUARIO=galenos
DB_CONTRASENA=cambiar_contrasena
DB_ROOT_CONTRASENA=cambiar_contrasena_root
DB_PUERTO=3311
# allowPublicKeyRetrieval=true: MySQL 8.4 autentica con caching_sha2_password y, tras reiniciar MySQL,
# la primera conexión necesita la clave pública del servidor. Sin el parámetro, la API falla con
# "pool failed to retrieve a connection (active=0 idle=0)". En producción use TLS en su lugar.
DATABASE_URL=mysql://galenos:cambiar_contrasena@localhost:3311/ambulancias_galenos?allowPublicKeyRetrieval=true
SHADOW_DATABASE_URL=mysql://galenos:cambiar_contrasena@localhost:3311/ambulancias_galenos_sombra

# Autenticación (JWT_SECRETO: mínimo 32 caracteres aleatorios)
JWT_SECRETO=
JWT_EXPIRACION_SEGUNDOS=28800

# Usuario administrador inicial creado por el seed
SEMILLA_ADMIN_CORREO=admin@ambulanciasgalenos.co
SEMILLA_ADMIN_CONTRASENA=

# Geocodificación (dirección → coordenadas)
# Clave de https://myprojects.geoapify.com. Si queda vacía, POST /geocodificacion responde 503.
GEOAPIFY_API_KEY=
# Proveedores en orden de uso, separados por coma (el siguiente es el respaldo). Hoy: geoapify
GEOCODIFICACION_PROVEEDORES=geoapify
# Código ISO del país al que se restringen las búsquedas
GEOCODIFICACION_PAIS=co
# Ciudad que se asume si la solicitud no la trae (ej. Bogotá). Vacía = la ciudad es obligatoria
GEOCODIFICACION_CIUDAD_PREDETERMINADA=
# Confianza mínima (0 a 1) para aceptar un resultado
GEOCODIFICACION_CONFIANZA_MINIMA=0.6
# Tiempo máximo de espera por proveedor, en milisegundos
GEOCODIFICACION_TIEMPO_ESPERA_MS=8000
# Clic en el mapa → dirección: hasta cuántos metros la calle encontrada describe el punto
GEOCODIFICACION_INVERSA_DISTANCIA_MAXIMA_M=100

# Rutas por calles de las ambulancias (usa GEOAPIFY_API_KEY)
# Proveedores en orden, separados por coma (el siguiente es el respaldo)
RUTAS_PROVEEDORES=geoapify
# A cuántos metros de la ruta se recalcula por desvío
RUTAS_DISTANCIA_DESVIO_M=150
# Mínimo de segundos entre dos recálculos del mismo servicio
RUTAS_INTERVALO_RECALCULO_S=60
# Tiempo máximo de espera del proveedor, en milisegundos
RUTAS_TIEMPO_ESPERA_MS=8000

# Ciclo de atención: radio (m) de referencia para que el conductor confirme la llegada.
# No confirma solo: fuera del radio, el conductor debe justificarlo.
ASIGNACIONES_RADIO_LLEGADA_M=100

# Carpeta privada para las fotos de documentos de los ciudadanos (nunca pública).
# Opcional: por defecto ./almacenamiento-privado
ALMACENAMIENTO_PRIVADO_RUTA=almacenamiento-privado

# Tiempo real (servidor aparte: ../../webSocket)
# Si alguna de las dos queda vacía, la API funciona igual pero no envía notificaciones
TIEMPO_REAL_URL=http://localhost:3001
# Secreto compartido con el servidor de tiempo real (CLAVE_INTERNA allá). Mínimo 32 caracteres aleatorios
TIEMPO_REAL_CLAVE_INTERNA=
